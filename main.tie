type tie<logic>
//
// main.tie —— tie 语言自写的包管理器 CLI 入口（Harbor M6 骨架 E1/E2 + E3/E4）
//
// 使用（由 Rust 侧 crates/tie/src/main.rs 识别子命令后编译执行本入口）：
//   tie init <项目名>     初始化项目（生成 tpkg.config.td + main.tie 模板）
//   tie add <依赖>        添加依赖（path 源 / git 源 / registry 版本约束）
//   tie remove <包名>     移除依赖
//   tie install           安装全部依赖（解析 + 拉取 + 生成/校验 tie.lock）
//   tie update [包名]     重新解析依赖并更新 tie.lock
//   tie build             编译项目（调用 tie 编译器）
//   tie run               运行项目
//   tie publish           打包发布（.tpkg + git tag/push）
//   tie search <关键字>   搜索注册表 index.tie
//   tie info <包名>       查询注册表包信息
//   tie help              显示帮助
//
// 架构：本文件只做「CLI 子命令分派 + 编排」，具体能力按模块分工——
//   manifest（./mf.tie）   tpkg.config.td 清单解析（tie:data 文本 → 依赖项）
//   deps（./dp.tie）       依赖安装/解析（path/git/registry 三源 + 锁文件落地）
//   publish（./pb.tie）    打包发布（.tpkg + git tag/push）
//   search（./sr.tie）     注册表搜索/信息查询
// Rust 侧只做两件事：子命令识别 + exec pkg.exe（自举：包管理器 100% tie 写）。
//
// import 约束（M6 E3/E4 起）：tie 的 import 是文本内联，同一命名空间被两个
// 模块同时 import 会重复定义。本文件的 import 树如下（每文件只被导入一次）：
//   main → manifest / deps（→ fetch → version / lock）/ publish / search；
// 故版本校验与 git 源判定等经 dp.* 透传（dp 内部 import fetch/lock）。
//
// tie 约束处理（重要）：
// - **表参数元素类型静态未知**：跨模块传参一律用逗号分隔字符串序列
//   （mf.dep_names / dep_specs），本文件不直接操作表；
// - **tie 的 && 非短路**：`i < n && expr` 这类「边界 + 下标」连写会越界，
//   全部改用嵌套 if 或拆开判断；
// - **无 continue/break/递归**：迭代 + return 提前退出；
// - `table`/`text`/`code`/`char`/`bool`/`i64`/`f64` 是类型关键字，不可作
//   变量名/参数名（清单文本用 src 命名，不叫 text）；
// - 命令行参数经 arg_string(i) 读取（0 = 子命令名，1.. = 子命令参数），
//   越界返回空串。

import "./manifest.tie" as mf
import "./deps.tie" as dp
import "./publish.tie" as pb
import "./pack.tie" as pk
import "./search.tie" as sr
import "./scaffold.tie" as sc
import "./license.tie" as lic

// ================= 入口：子命令分派 =================

func main() -> i64 {
    var n = arg_count()
    // 无参数：打印帮助
    if n == 0 {
        print(help_text())
        return 0
    }
    var cmd = arg_string(0)
    // 子命令分派（help 优先展示）
    if cmd == "help" {
        return cmd_help()
    }
    if cmd == "init" {
        return cmd_init()
    }
    if cmd == "new" {
        return cmd_new()
    }
    if cmd == "template" {
        return cmd_template()
    }
    if cmd == "license" {
        return cmd_license()
    }
    if cmd == "add" {
        return cmd_add()
    }
    if cmd == "remove" {
        return cmd_remove()
    }
    if cmd == "install" {
        return cmd_install()
    }
    if cmd == "update" {
        return cmd_update()
    }
    if cmd == "build" {
        return cmd_build()
    }
    if cmd == "run" {
        return cmd_run()
    }
    if cmd == "publish" {
        return cmd_publish()
    }
    if cmd == "pack" {
        return cmd_pack()
    }
    if cmd == "verify" {
        return cmd_verify()
    }
    if cmd == "search" {
        return cmd_search()
    }
    if cmd == "info" {
        return cmd_info()
    }
    // 未知命令：报错并给帮助
    print_err("[pkg] 未知命令: " + cmd + "\n")
    print(help_text())
    return 1
}

// ================= 帮助 =================

func cmd_help() -> i64 {
    print(help_text())
    return 0
}

// 帮助文本（拼接待转义字符串；命令用法一目了然）。
func help_text() -> string {
    return "tie 包管理器（Harbor M6，tie 语言自写）\n" +
           "\n" +
           "用法:\n" +
           "  tie init <项目名>      初始化项目（--kind=<档>；变体同 tie new）\n" +
           "  tie new <项目名>      脚手架新建（--kind=<档> 三十五档；--template=<名> 用户模板）\n" +
           "  tie add <依赖>         添加依赖\n" +
           "  tie remove <包名>      移除依赖\n" +
           "  tie install            安装全部依赖到 .tie/deps/（解析 + 生成 tie.lock）\n" +
           "  tie update [包名]      重新解析依赖并更新 tie.lock\n" +
           "  tie build              编译项目（调用 tie 编译器）\n" +
           "  tie run                运行项目（tie <main 文件>）\n" +
           "  tie publish            打包发布（.tpkg + git tag/push）\n" +
           "  tie pack               打包分发单元（tieir + signature + .tpkg）\n" +
           "  tie verify <包名>      校验已安装包（S3.2：signature 哈希比对）\n" +
           "  tie search <关键字>    搜索注册表（TIE_REGISTRY 可指定基址）\n" +
           "  tie info <包名>        查询注册表包信息\n" +
           "  tie template list      列出官方档与用户模板\n" +
           "  tie license <子命令>   许可证：detect 识别 / check 校验 / list 大全\n" +
           "  tie help               显示本帮助\n" +
           "\n" +
           "依赖写法:\n" +
           "  path:./lib_math                 本地路径源（复制目录到 .tie/deps/lib_math/）\n" +
           "  git+https://host/repo.git        git 源（https；#v1.0.0 后缀指定 tag）\n" +
           "  git@host:repo.git                git 源（ssh；认证走用户密钥）\n" +
           "  name@1.0.0                       注册表精确版本\n" +
           "  name@^1.2 / name@*               注册表版本约束（^1.2 或最新）\n" +
           "\n" +
           "注册表: 默认 https://pkg.tie-lang.org，可用环境变量 TIE_REGISTRY 覆盖\n"
}

// ================= tie init：初始化项目 =================

func cmd_init() -> i64 {
    var name = arg_string(1)
    if name == "" {
        print_err("[pkg] 用法: tie init <项目名> [--kind=<档>] [变体…]\n")
        return 1
    }
    var kind = "cli"
    var variants = table_new_string()
    var licid: string = ""
    var ai: i64 = 2
    while ai < arg_count() {
        var a = arg_string(ai)
        if mf.starts_with(a, "--kind=") {
            kind = mf.slice(a, 7, len(a))
        } else if mf.starts_with(a, "--license=") {
            licid = mf.slice(a, 10, len(a))
        } else if mf.starts_with(a, "--") && len(a) > 2 {
            table_push(variants, mf.slice(a, 2, len(a)))
        }
        ai = ai + 1
    }
    if !sc.sc_kind_valid(kind) {
        print_err("[pkg] 未知档 kind: " + kind + "（tie template list 查看全部）\n")
        return 1
    }
    if !variants_ok(kind, variants) {
        return 1
    }
    if licid != "" {
        if !lic.lic_known(licid) {
            println("[pkg] 提示: 未知许可证标识 " + licid + "（将写入引用式；tie license list 查看内置大全）")
        }
        sc.sc_set_license(licid)
    }
    if !mkdir_all(name) {
        print_err("[pkg] 创建目录失败: " + name + "\n")
        return 1
    }
    // 宽容生成（已存在文件跳过；可在既有目录补骨架）
    var failed = sc.sc_fill_missing_v(name, name, kind, variants)
    if failed > 0 {
        print_err("[pkg] 骨架生成完成，失败 " + to_string(failed) + " 项\n")
        return 1
    }
    println("[pkg] 项目初始化完成: " + name + "（kind " + kind + "）")
    println("[pkg] 下一步: cd " + name + " && tie add <依赖> && tie install && tie run")
    return 0
}

func cmd_new() -> i64 {
    // 参数扫描：首个普通参数为项目名；--kind= / --template= / --git
    var name: string = ""
    var kind: string = ""
    var tpl: string = ""
    var want_git: bool = false
    var licid: string = ""
    var variants = table_new_string()
    var i: i64 = 1
    while i < arg_count() {
        var a = arg_string(i)
        if mf.starts_with(a, "--kind=") {
            kind = mf.slice(a, 7, len(a))
        } else if mf.starts_with(a, "--template=") {
            tpl = mf.slice(a, 11, len(a))
        } else if mf.starts_with(a, "--license=") {
            licid = mf.slice(a, 10, len(a))
        } else if a == "--git" {
            want_git = true
        } else if mf.starts_with(a, "--") && len(a) > 2 {
            table_push(variants, mf.slice(a, 2, len(a)))
        } else if name == "" {
            name = a
        }
        i = i + 1
    }
    if name == "" {
        print_err("[pkg] 用法: tie new <项目名> [--kind=<档>] [--template=<用户模板>] [--git]\n")
        print_err("[pkg]   示例: tie new my-tool --kind=cli\n")
        print_err("[pkg]         tie new my-api  --kind=backend\n")
        print_err("[pkg]         tie new my-lib  --kind=lib\n")
        print_err("[pkg]         tie new my-proj --template=our-team\n")
        print_err("[pkg]         tie new my-lib  --kind=lib --license=MIT\n")
        print_err("[pkg]         tie template list（列出官方档与用户模板）\n")
        return 1
    }
    if !safe_project_name(name) {
        print_err("[pkg] 项目名非法（仅允许字母/数字/_/-/.，且不得含路径分隔）: " + name + "\n")
        return 1
    }
    if dir_exists(name) {
        print_err("[pkg] 目录已存在: " + name + "（未生成任何文件）\n")
        return 1
    }
    if tpl != "" && kind != "" {
        print_err("[pkg] --kind 与 --template 互斥\n")
        return 1
    }
    if tpl != "" && len(variants) > 0 {
        print_err("[pkg] --template 模式不支持变体\n")
        return 1
    }
    if !mkdir_all(name) {
        print_err("[pkg] 创建目录失败: " + name + "\n")
        return 1
    }
    var failed: i64 = 0
    if tpl != "" {
        if !sc.sc_user_exists(tpl) {
            print_err("[pkg] 用户模板不存在: " + tpl + "（目录: " + sc.sc_user_root() + "）\n")
            return 1
        }
        failed = sc.sc_generate_user(name, name, tpl)
        if failed == 0 {
            println("[pkg] 已按用户模板生成: " + name + "（模板 " + tpl + "）")
        }
    } else {
        if kind == "" {
            kind = "cli"
        }
        if !sc.sc_kind_valid(kind) {
            print_err("[pkg] 未知档 kind: " + kind + "\n")
            var ks = sc.sc_kind_list()
            var k: i64 = 0
            while k < len(ks) {
                print_err(ks[k] + " ")
                k = k + 1
            }
            print_err("\n")
            return 1
        }
        if !variants_ok(kind, variants) {
            return 1
        }
        if licid != "" {
            if !lic.lic_known(licid) {
                println("[pkg] 提示: 未知许可证标识 " + licid + "（将写入引用式；tie license list 查看内置大全）")
            }
            sc.sc_set_license(licid)
        }
        failed = sc.sc_generate_v(name, name, kind, variants)
        if failed == 0 {
            var vtail = ""
            if len(variants) > 0 {
                vtail = "，变体 " + to_string(len(variants)) + " 个"
            }
            println("[pkg] 已生成: " + name + "（kind " + kind + vtail + "）")
        }
    }
    if want_git {
        var rc = exec_code("git init " + name)
        if rc == 0 {
            println("[pkg] 已 git init: " + name)
        } else {
            print_err("[pkg] git init 失败（可稍后手动执行）\n")
        }
    }
    if failed > 0 {
        print_err("[pkg] 脚手架生成完成，失败 " + to_string(failed) + " 项\n")
        return 1
    }
    println("[pkg] 下一步: cd " + name)
    return 0
}

// tpkg license —— 许可证识别 / 校验 / 大全（规范 7.3）。
func cmd_license() -> i64 {
    var sub = arg_string(1)
    if sub == "" || sub == "detect" {
        if !file_exists("LICENSE") {
            print_err("[pkg] 未找到 LICENSE（当前目录）\n")
            return 1
        }
        var src = file_read("LICENSE")
        var d = lic.lic_detect(src)
        if d.0 == "Custom" {
            println("[pkg] 识别结果: 自定义/未识别（不在内置大全中）")
            return 2
        }
        println("[pkg] 识别结果: " + d.0 + "（置信度 " + to_string(d.1) + "）")
        return 0
    }
    if sub == "check" {
        if !file_exists("tpkg.config.td") {
            print_err("[pkg] 未找到 tpkg.config.td（请在项目根执行）\n")
            return 1
        }
        var msrc = file_read("tpkg.config.td")
        var declared = mf.field(msrc, "license")
        return lic.lic_check_report(declared, "LICENSE")
    }
    if sub == "list" {
        println("[pkg] 内置许可证大全（tie license detect 可识别；注入见 new --license=<id>）：")
        var t = lic.lic_list()
        var i: i64 = 0
        while i < len(t) {
            println("  " + t[i])
            i = i + 1
        }
        return 0
    }
    print_err("[pkg] 用法: tie license detect | check | list\n")
    return 1
}

// tpkg template —— 模板清单（官方 35 档 + 用户模板）。
func cmd_template() -> i64 {
    var sub = arg_string(1)
    if sub == "" || sub == "list" {
        println("[pkg] 官方档（35 个；tie new --kind=<档>）：")
        var ks = sc.sc_kind_list()
        var i: i64 = 0
        while i < len(ks) {
            println("  " + ks[i])
            i = i + 1
        }
        println("[pkg] 用户模板（tie new --template=<名>；目录 " + sc.sc_user_root() + "）：")
        var us = sc.sc_user_list()
        if len(us) == 0 {
            println("  （无）")
        } else {
            i = 0
            while i < len(us) {
                println("  " + us[i])
                i = i + 1
            }
        }
        return 0
    }
    print_err("[pkg] 用法: tie template list\n")
    return 1
}

// 变体校验 + 冲突检查（new / init 共用）；不通过时打印可操作提示并返回 false。
func variants_ok(kind: string, variants: table<string>) -> bool {
    var vv: i64 = 0
    while vv < len(variants) {
        if !sc.sc_variant_valid(kind, variants[vv]) {
            print_err("[pkg] 档 " + kind + " 不支持变体: --" + variants[vv] + "\n")
            print_err("[pkg] 该档可用变体: ")
            var vl = sc.sc_variant_list(kind)
            if len(vl) == 0 {
                print_err("（无）")
            } else {
                var vk: i64 = 0
                while vk < len(vl) {
                    print_err("--" + vl[vk] + " ")
                    vk = vk + 1
                }
            }
            print_err("\n")
            return false
        }
        vv = vv + 1
    }
    var v1i: i64 = 0
    while v1i < len(variants) {
        var v2i: i64 = v1i + 1
        while v2i < len(variants) {
            if sc.sc_conflict(kind, variants[v1i], variants[v2i]) {
                print_err("[pkg] 变体冲突: --" + variants[v1i] + " 与 --" + variants[v2i] + " 不可同时使用\n")
                return false
            }
            v2i = v2i + 1
        }
        v1i = v1i + 1
    }
    return true
}

// 写文件（已存在则跳过返回 true；写失败返回 false）。调用于 new 脚手架。
func write_if_absent(path: string, content: string) -> bool {
    if file_exists(path) {
        return true
    }
    return file_write(path, content)
}

// 项目名是否为目录安全名：非空、仅含 [A-Za-z0-9._-]，且不含 / \ （排除路径穿越）。
func safe_project_name(name: string) -> bool {
    var okchars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
    var n: i64 = len(name)
    if n == 0 {
        return false
    }
    var i: i64 = 0
    while i < n {
        if mf.find(okchars, str_char(name, i)) < 0 {
            return false
        }
        i = i + 1
    }
    return true
}

// 目录是否存在（file_exists 对目录恒 false，用 list_dir 探测）。
func dir_exists(name: string) -> bool {
    var entries = list_dir(name)
    return len(entries) > 0
}

// ================= tie add：添加依赖 =================

func cmd_add() -> i64 {
    var spec_arg = arg_string(1)
    if spec_arg == "" {
        print_err("[pkg] 用法: tie add <依赖>\n")
        print_err("[pkg]   示例: tie add path:./lib_math                 （本地 path 源）\n")
        print_err("[pkg]         tie add log@1.0.0                       （注册表精确版本）\n")
        print_err("[pkg]         tie add log@^1.2                        （注册表版本约束）\n")
        print_err("[pkg]         tie add demo@git+https://host/repo.git  （git 源）\n")
        return 1
    }
    if !file_exists("tpkg.config.td") {
        print_err("[pkg] 未找到 tpkg.config.td（请先 tie init <项目名>）\n")
        return 1
    }
    var src = file_read("tpkg.config.td")
    var name = add_name(spec_arg)
    if name == "" {
        print_err("[pkg] 无法解析包名: " + spec_arg + "\n")
        return 1
    }
    var spec = add_spec(spec_arg)
    // registry 版本约束格式校验：path/git 源跳过；约束须合法
    // （x.y.z 精确 / ^x.y 区间 / >=x.y 下界 / * 最新）
    if !mf.starts_with(spec_arg, "path:") {
        if !dp.is_git(spec_arg) {
            if !dp.valid_version(spec) {
                print_err("[pkg] 警告: 版本 \"" + spec + "\" 格式非法（期望 x.y.z / ^x.y / >=x.y / *）\n")
            }
        }
    }
    // 查重：同名依赖已存在则拒绝
    var cnt = mf.dep_count(src)
    var i: i64 = 0
    var exists: bool = false
    while i < cnt {
        if mf.dep_name(src, i) == name {
            exists = true
        }
        i = i + 1
    }
    if exists {
        print_err("[pkg] 依赖已存在: " + name + "（可先 tie remove " + name + "）\n")
        return 1
    }
    // 写入 tpkg.config.td
    var updated = mf.add_dep(src, name, spec)
    if file_write("tpkg.config.td", updated) {
        println("[pkg] 已添加依赖 " + name + " @ " + spec)
        return 0
    }
    print_err("[pkg] 写入 tpkg.config.td 失败\n")
    return 1
}

// 从 add 参数解析包名：
//   path:./lib_math                     → "lib_math"（路径 basename）
//   git+https://host/repo.git#v1        → "repo"（git 整体形式，取仓库名）
//   git@host:repo.git                   → "repo"（同上）
//   name@version / name@git+...         → "name"（第一个 @ 前；@ 是名字/约束分隔符）
//   https://host/repo.git               → "repo"（无 @ 的裸 git URL）
//   裸 name                             → "name"
func add_name(spec_arg: string) -> string {
    if mf.starts_with(spec_arg, "path:") {
        var p = mf.slice(spec_arg, 5, len(spec_arg))
        return path_basename(p)
    }
    // git 整体形式（git+ / git@ 开头）：@ 是 URL 的一部分，整串即 git 源
    if mf.starts_with(spec_arg, "git+") {
        return dp.git_name(spec_arg)
    }
    if mf.starts_with(spec_arg, "git@") {
        return dp.git_name(spec_arg)
    }
    // 第一个 @ 是「名字@约束」分隔符（log@1.0.0 / demo@git+...）
    var at = mf.find(spec_arg, "@")
    if at >= 0 {
        return mf.slice(spec_arg, 0, at)
    }
    // 无 @：裸 git URL（含 .git）→ 取仓库名；否则裸名字
    if dp.is_git(spec_arg) {
        return dp.git_name(spec_arg)
    }
    return spec_arg
}

// 从 add 参数解析 spec：path/git 整体保留；
// name@1.0.0 → "1.0.0"；裸 name → "*"（任意版本）。
func add_spec(spec_arg: string) -> string {
    if mf.starts_with(spec_arg, "path:") {
        return spec_arg
    }
    if mf.starts_with(spec_arg, "git+") {
        return spec_arg
    }
    if mf.starts_with(spec_arg, "git@") {
        return spec_arg
    }
    // 第一个 @ 是「名字@约束」分隔符：取其后的部分（版本或 git 源 spec）
    var at = mf.find(spec_arg, "@")
    if at >= 0 {
        return mf.slice(spec_arg, at + 1, len(spec_arg))
    }
    // 无 @：裸 git URL → 整体作为 spec；裸名字 → 任意版本
    if dp.is_git(spec_arg) {
        return spec_arg
    }
    return "*"
}

// ================= tie remove：移除依赖 =================

func cmd_remove() -> i64 {
    var name = arg_string(1)
    if name == "" {
        print_err("[pkg] 用法: tie remove <包名>\n")
        return 1
    }
    if !file_exists("tpkg.config.td") {
        print_err("[pkg] 未找到 tpkg.config.td\n")
        return 1
    }
    var src = file_read("tpkg.config.td")
    var updated = mf.remove_dep(src, name)
    // 文本未变 → 依赖不存在
    if updated == src {
        print_err("[pkg] 依赖不存在: " + name + "\n")
        return 1
    }
    if file_write("tpkg.config.td", updated) {
        println("[pkg] 已移除依赖 " + name)
        return 0
    }
    print_err("[pkg] 写入 tpkg.config.td 失败\n")
    return 1
}

// ================= tie install：安装依赖 =================

func cmd_install() -> i64 {
    if !file_exists("tpkg.config.td") {
        print_err("[pkg] 未找到 tpkg.config.td（请先 tie init <项目名>）\n")
        return 1
    }
    var src = file_read("tpkg.config.td")
    // 依赖名与 spec 各为逗号分隔序列（规避表参数限制）
    var names = mf.dep_names(src)
    if names == "" {
        println("[pkg] 无依赖，跳过安装")
        return 0
    }
    var specs = mf.dep_specs(src)
    // 建安装目录 .tie/deps/
    if !mkdir_all(".tie/deps") {
        print_err("[pkg] 创建 .tie/deps 失败\n")
        return 1
    }
    println("[pkg] 安装依赖到 .tie/deps/ ...")
    var lock_text: string = ""
    var from_lock: bool = false
    // 幂等：tie.lock 存在且与当前 tpkg.config.td 直接依赖一致 → 直接按锁文件恢复（不重新拉取）
    if dp.lock_exists() {
        var lt = dp.lock_read()
        if dp.lock_valid(lt, src) {
            lock_text = lt
            from_lock = true
        }
    }
    var failed: i64 = 0
    if from_lock {
        println("[pkg] tie.lock 有效，按锁文件恢复（幂等）")
        failed = dp.install_from_lock(lock_text)
    } else {
        // 无锁/锁失效：重新解析（三源递归 + 去重 + 冲突检测）→ 生成锁 → 安装
        var pkg_name = mf.field(src, "name")
        var pkg_ver = mf.field(src, "version")
        lock_text = dp.resolve(names, specs, pkg_name, pkg_ver)
        if lock_text == "" {
            print_err("[pkg] 依赖解析失败\n")
            return 1
        }
        if dp.lock_write(lock_text) {
            println("[pkg] 已生成 tie.lock")
        } else {
            print_err("[pkg] 写入 tie.lock 失败\n")
        }
        failed = dp.install_from_lock(lock_text)
    }
    if failed > 0 {
        print_err("[pkg] 安装完成，失败 " + to_string(failed) + " 项\n")
        return 1
    }
    // S3.2（P5c）：安装后自动校验签名——包内含 signature + .tieir 的依赖
    // 逐一校验哈希（防篡改/防损坏，安全底线：校验失败 = 安装报错）
    var vfailed = verify_installed(lock_text)
    if vfailed > 0 {
        print_err("[pkg] 签名校验失败 " + to_string(vfailed) + " 项——校验失败 = 安装报错（P5c 安全底线）\n")
        return 1
    }
    println("[pkg] 全部依赖安装完成")
    return 0
}

// S3.2（P5c）：按锁文件遍历已安装依赖，逐个签名校验（无 signature 的包跳过
// ——旧包/未签名包兼容；有 signature 必须哈希匹配）。返回失败个数。
func verify_installed(lock_text: string) -> i64 {
    var names_seq = dp.lock_names(lock_text)
    if names_seq == "" {
        return 0
    }
    var vf: i64 = 0
    var i: i64 = 0
    var n = len(names_seq)
    while i < n {
        var name = mf.segment(names_seq, i)
        if name != "" {
            var dir = ".tie/deps/" + name
            // 无 signature = 未签名包，跳过（兼容既有 path/git 源）
            if file_exists(dir + "/signature") {
                var rc = pk.verify(dir, name)
                if rc != 0 {
                    vf = vf + 1
                }
            }
        }
        i = i + 1
    }
    return vf
}

// ================= tie update：重新解析依赖并更新 tie.lock =================

func cmd_update() -> i64 {
    var pkg = arg_string(1)
    if !file_exists("tpkg.config.td") {
        print_err("[pkg] 未找到 tpkg.config.td（请先 tie init <项目名>）\n")
        return 1
    }
    var src = file_read("tpkg.config.td")
    var names = mf.dep_names(src)
    if names == "" {
        println("[pkg] 无依赖，无需更新")
        return 0
    }
    var specs = mf.dep_specs(src)
    if !mkdir_all(".tie/deps") {
        print_err("[pkg] 创建 .tie/deps 失败\n")
        return 1
    }
    // 可选包名参数：当前版本无论是否指定都重新解析全部依赖
    if pkg != "" {
        println("[pkg] 更新 " + pkg + "（当前版本重新解析全部依赖）")
    } else {
        println("[pkg] 重新解析全部依赖 ...")
    }
    var pkg_name = mf.field(src, "name")
    var pkg_ver = mf.field(src, "version")
    var lock_text = dp.resolve(names, specs, pkg_name, pkg_ver)
    if lock_text == "" {
        print_err("[pkg] 依赖解析失败\n")
        return 1
    }
    if dp.lock_write(lock_text) {
        println("[pkg] 已更新 tie.lock")
    } else {
        print_err("[pkg] 写入 tie.lock 失败\n")
    }
    var failed = dp.install_from_lock(lock_text)
    if failed > 0 {
        print_err("[pkg] 安装完成，失败 " + to_string(failed) + " 项\n")
        return 1
    }
    println("[pkg] 更新完成")
    return 0
}

// ================= tie publish / search / info =================

func cmd_publish() -> i64 {
    if !file_exists("tpkg.config.td") {
        print_err("[pkg] 未找到 tpkg.config.td（请先 tie init <项目名>）\n")
        return 1
    }
    var src = file_read("tpkg.config.td")
    var name = mf.field(src, "name")
    var version = mf.field(src, "version")
    var kind = mf.field(src, "kind")
    if kind == "" {
        println("[pkg] 提示: tpkg.config.td 缺 kind 字段（规范要求；见 tpkg-spec）")
    }
    var main_file = mf.field(src, "main")
    if main_file == "" {
        main_file = sc.sc_main_rel(kind)
    }
    if main_file == "" {
        main_file = "main.tie"
    }
    // 许可证一致性（规范 7.3：以 LICENSE 为准；提示不拦）
    var decl_lic2 = mf.field(src, "license")
    var licrc2 = lic.lic_check_report(decl_lic2, "LICENSE")
    var exports = mf.field(src, "exports")
    return pb.publish(name, version, main_file, exports)
}

// S3.2：tie pack —— 打包分发单元（tieir + signature + .tpkg）。
// 多文件包（L1c）：tpkg.config.td 的 exports 字段声明附加导出入口（逗号分隔），
// 包内模块互相 import 私有，对外只暴露入口声明面。
func cmd_pack() -> i64 {
    if !file_exists("tpkg.config.td") {
        print_err("[pkg] 未找到 tpkg.config.td（请先 tie init <项目名>）\n")
        return 1
    }
    var src = file_read("tpkg.config.td")
    var name = mf.field(src, "name")
    var version = mf.field(src, "version")
    var kind = mf.field(src, "kind")
    if kind == "" {
        println("[pkg] 提示: tpkg.config.td 缺 kind 字段（规范要求；见 tpkg-spec）")
    }
    var main_file = mf.field(src, "main")
    if main_file == "" {
        main_file = sc.sc_main_rel(kind)
    }
    if main_file == "" {
        main_file = "main.tie"
    }
    // 许可证一致性（规范 7.3：以 LICENSE 为准；提示不拦）
    var decl_lic = mf.field(src, "license")
    var licrc = lic.lic_check_report(decl_lic, "LICENSE")
    var exports = mf.field(src, "exports")
    return pk.pack(name, version, main_file, exports)
}

// S3.2：tie verify <包名> —— 校验已安装包（signature + tieir 哈希比对，P5c）。
func cmd_verify() -> i64 {
    var pkg_name = arg_string(1)
    if pkg_name == "" {
        print_err("[pkg] 用法: tie verify <包名>\n")
        return 1
    }
    return pk.verify(".tie/deps/" + pkg_name, pkg_name)
}

func cmd_search() -> i64 {
    var query = arg_string(1)
    return sr.search(query)
}

func cmd_info() -> i64 {
    var pkg = arg_string(1)
    if pkg == "" {
        print_err("[pkg] 用法: tie info <包名>\n")
        return 1
    }
    return sr.info(pkg)
}

// ================= tie build / tie run =================

// 读 tpkg.config.td 的 main 字段（缺省 main.tie）；清单缺失返回空串。
func main_of_pkg() -> string {
    if !file_exists("tpkg.config.td") {
        print_err("[pkg] 未找到 tpkg.config.td（请先 tie init <项目名>）\n")
        return ""
    }
    var src = file_read("tpkg.config.td")
    var main_file = mf.field(src, "main")
    if main_file == "" {
        main_file = "main.tie"
    }
    return main_file
}

func cmd_build() -> i64 {
    var main_file = main_of_pkg()
    if main_file == "" {
        return 1
    }
    println("[pkg] 编译: tie " + main_file)
    // 首版：提示后自动调用 tie 编译器（子进程；失败时提示手动执行）
    var rc = exec_code("tie " + main_file)
    if rc == 0 {
        println("[pkg] 编译成功: " + main_file)
    } else {
        print_err("[pkg] 编译未完成（可手动执行: tie " + main_file + "）\n")
    }
    return rc
}

func cmd_run() -> i64 {
    var main_file = main_of_pkg()
    if main_file == "" {
        return 1
    }
    println("[pkg] 运行: tie " + main_file)
    // 先编译（tie <文件> 生成同名 .exe；退出码非 0 → 提示手动执行）
    var rc = exec_code("tie " + main_file)
    if rc != 0 {
        print_err("[pkg] 编译未完成（可手动执行: tie " + main_file + "）\n")
        return rc
    }
    // 再执行编译产物（main.tie → main.exe / ./main，平台自适应）
    var exe_name = exe_of(main_file)
    println("[pkg] 执行: " + exe_name)
    return exec_code(exe_name)
}

// 由入口文件推导可执行文件名：main.tie → main.exe（Windows）或 ./main（Unix）。
// 用 file_exists 探测产物命名（编译路径按平台生成），两者皆无则回退 .exe。
func exe_of(main_file: string) -> string {
    // 取基名（去扩展名）
    var dot = mf.find(main_file, ".")
    var base = main_file
    if dot > 0 {
        base = mf.slice(main_file, 0, dot)
    }
    // Windows 产物 <base>.exe；Unix 产物 ./<base>
    if file_exists(base + ".exe") {
        return base + ".exe"
    }
    if file_exists("./" + base) {
        return "./" + base
    }
    return base + ".exe"
}
