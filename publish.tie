type tie<class>
// publish.tie —— 发布模块（Harbor M6 包管理器 E4）
//
// 职责：`tie publish` 打包（复用 pack，与 tie pack 完全同源：tieir + signature +
// .tpkg）并打 git tag / push：
//   1. 读 tpkg.config.td（由 main 读好 name/version/main/exports 传入）；
//   2. 调用 pack.pack 完成打包（tzp 容器链路）；
//   3. git tag v<version> + git push --tags（best-effort，非 git 仓库时提示跳过）；
//      HTTP 注册表上传接口留占位（见 docs/plans/package-manager.md §3.9）。
//
// tie 约束处理（重要）：
// - 打包复用 pack 模块（import 置于文件末尾——命名空间收集顺序 [publish, pack]）；
// - **tie 的 && 非短路**：边界判断与下标不写进同一条件，用嵌套 if；
// - 无 continue/break：迭代 + return 提前退出。

namespace publish {
    // ================= 通用字符串工具（自备） =================

    func slice(s: string, start: i64, end: i64) -> string {
        var n: i64 = len(s)
        var lo: i64 = start
        if lo < 0 {
            lo = 0
        }
        if lo > n {
            lo = n
        }
        var hi: i64 = end
        if hi < 0 {
            hi = 0
        }
        if hi > n {
            hi = n
        }
        var result: string = ""
        var i: i64 = lo
        while i < hi {
            result = result + str_char(s, i)
            i = i + 1
        }
        return result
    }

    func find(s: string, sub: string) -> i64 {
        var n: i64 = len(s)
        var m: i64 = len(sub)
        if m == 0 {
            return 0
        }
        if m > n {
            return -1
        }
        var i: i64 = 0
        while i <= n - m {
            var j: i64 = 0
            var matched: bool = true
            while j < m && matched {
                if str_char(s, i + j) != str_char(sub, j) {
                    matched = false
                }
                j = j + 1
            }
            if matched {
                return i
            }
            i = i + 1
        }
        return -1
    }

    func starts_with(s: string, prefix: string) -> bool {
        var n: i64 = len(s)
        var m: i64 = len(prefix)
        if m > n {
            return false
        }
        var i: i64 = 0
        while i < m {
            if str_char(s, i) != str_char(prefix, i) {
                return false
            }
            i = i + 1
        }
        return true
    }

    func ends_with(s: string, suffix: string) -> bool {
        var n: i64 = len(s)
        var m: i64 = len(suffix)
        if m > n {
            return false
        }
        var i: i64 = 0
        while i < m {
            if str_char(s, n - m + i) != str_char(suffix, i) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // 是否合法的 x.y.z 版本串（纯数字与点、首尾数字、无连续点）。
    func is_semver(s: string) -> bool {
        var n: i64 = len(s)
        if n == 0 {
            return false
        }
        var digits = "0123456789"
        if find(digits, str_char(s, 0)) < 0 {
            return false
        }
        if find(digits, str_char(s, n - 1)) < 0 {
            return false
        }
        var prev_dot: bool = false
        var i: i64 = 0
        while i < n {
            var c = str_char(s, i)
            if c == "." {
                if prev_dot {
                    return false
                }
                prev_dot = true
            } else if find(digits, c) >= 0 {
                prev_dot = false
            } else {
                return false
            }
            i = i + 1
        }
        return true
    }

    // ================= 发布主流程 =================

    // 执行发布：打 tar.gz + git tag/push。name/version/main 由 main 从 tpkg.config.td 读出传入。
    pub func publish(name: string, version: string, main_file: string, exports: string) -> i64 {
        // 1) 校验清单字段
        if name == "" {
            print_err("[pkg] tpkg.config.td 缺少 name 字段\n")
            return 1
        }
        if version == "" {
            print_err("[pkg] tpkg.config.td 缺少 version 字段\n")
            return 1
        }
        if main_file == "" {
            print_err("[pkg] tpkg.config.td 缺少 main 字段\n")
            return 1
        }
        if !is_semver(version) {
            print_err("[pkg] 版本必须是 x.y.z 形式（当前: " + version + "）\n")
            return 1
        }

        // 2) 打包（复用 pack：tieir + signature + .tpkg；失败原样返回）
        var prc = pk.pack(name, version, main_file, exports)
        if prc != 0 {
            return prc
        }

        // 5) git tag + push（best-effort；HTTP 注册表上传接口留占位）
        var tg = exec_code("git tag v" + version)
        if tg != 0 {
            println("[pkg] git tag v" + version + " 已存在或当前目录非 git 仓库（跳过 tag/push）")
        } else {
            println("[pkg] 已打 tag: v" + version)
            var ps = exec_code("git push --tags")
            if ps != 0 {
                println("[pkg] git push --tags 失败（可稍后手动执行）")
            }
        }
        println("[pkg] 发布完成。HTTP 注册表上传接口为占位（见 docs/plans/package-manager.md）")
        return 0
    }

}

// 打包复用 pack 模块（与 tie pack 同源链路）。
import "./pack.tie" as pk;
