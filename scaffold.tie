    table_push(t, "ops")
    table_push(t, "os")
    table_push(t, "embedded")
    table_push(t, "spec")
    table_push(t, "doc")
    table_push(t, "book")
    table_push(t, "paper")
    table_push(t, "slides")
    table_push(t, "course")
    table_push(t, "data")
    table_push(t, "ml")
    table_push(t, "db")
    table_push(t, "simulation")
    table_push(t, "experiment")
    table_push(t, "hardware")
    table_push(t, "circuit")
    table_push(t, "modeling")
    table_push(t, "art")
    table_push(t, "photo")
    table_push(t, "comic")
    table_push(t, "music")
    table_push(t, "score")
    table_push(t, "audio")
    table_push(t, "video")
    table_push(t, "animation")
    table_push(t, "3d")
    return t
}

// ============================================================================
// 二、文本工具（自备）
// ============================================================================

func slice(s: string, start: i64, end: i64) -> string {
    var n: i64 = len(s)
    var lo: i64 = start
    if lo < 0 {
        lo = 0
    }
    if lo > n {
        lo = n
    }
    var hi: i64 = end
    if hi < 0 {
        hi = 0
    }
    if hi > n {
        hi = n
    }
    var out: string = ""
    var i: i64 = lo
    while i < hi {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

func starts_with(s: string, prefix: string) -> bool {
    var n: i64 = len(s)
    var m: i64 = len(prefix)
    if m > n {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 取 "|" 前段（main_rel）。
pub func sc_main_rel(kind: string) -> string {
    var def = sc_def(kind)
    if def == "" {
        return ""
    }
    var n: i64 = len(def)
    var i: i64 = 0
    while i < n {
        if str_char(def, i) == "|" {
            return slice(def, 0, i)
        }
        i = i + 1
    }
    return def
}

// 取 "|" 后段并按 "," 切分为目录表。
pub func sc_dirs(kind: string) -> table<string> {
    var out = table_new_string()
    var def = sc_def(kind)
    if def == "" {
        return out
    }
    // 跳过 | 前段
    var n: i64 = len(def)
    var i: i64 = 0
    var seg: i64 = 0 - 1
    while i < n {
        if str_char(def, i) == "|" {
            seg = i + 1
            i = n
        } else {
            i = i + 1
        }
    }
    if seg < 0 {
        return out
    }
    var cur: string = ""
    var j: i64 = seg
    while j < n {
        var c = str_char(def, j)
        if c == "," {
            if cur != "" {
                table_push(out, cur)
            }
            cur = ""
        } else {
            cur = cur + c
        }
        j = j + 1
    }
    if cur != "" {
        table_push(out, cur)
    }
    return out
}

// ns 净化：'-' '.' → '_'（库门面命名空间用）。
func ns_safe(name: string) -> string {
    var out: string = ""
    var i: i64 = 0
    var n: i64 = len(name)
    while i < n {
        var c = str_char(name, i)
        if c == "-" || c == "." {
            out = out + "_"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

// 全量替换（文本域；用于用户模板 {{name}}）。
func replace_all(s: string, from: string, to: string) -> string {
    var m: i64 = len(from)
    if m == 0 {
        return s
    }
    var out: string = ""
    var n: i64 = len(s)
    var i: i64 = 0
    while i < n {
        if i + m <= n {
            var hit = true
            var k: i64 = 0
            while k < m {
                if str_char(s, i + k) != str_char(from, k) {
                    hit = false
                    k = m
                } else {
                    k = k + 1
                }
            }
            if hit {
                out = out + to
                i = i + m
            } else {
                out = out + str_char(s, i)
                i = i + 1
            }
        } else {
            out = out + str_char(s, i)
            i = i + 1
        }
    }
    return out
}

// 逗号切分（目录表）。
func sc_split_csv(s: string) -> table<string> {
    var out = table_new_string()
    var cur: string = ""
    var i: i64 = 0
    var n: i64 = len(s)
    while i < n {
        var c = str_char(s, i)
        if c == "," {
            if cur != "" {
                table_push(out, cur)
            }
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    if cur != "" {
        table_push(out, cur)
    }
    return out
}

// 从表移除首个等于 v 的项。
func sc_remove_str(t: table<string>, v: string) -> table<string> {
    var out = table_new_string()
    var removed = false
    for x in t {
        if x == v && removed == false {
            removed = true
        } else {
            table_push(out, x)
        }
    }
    return out
}

// ============================================================================
// 三、公共面与入口内容
// ============================================================================

func sc_config(name: string, kind: string, main_rel: string) -> string {
    var sb = string_builder()
    sb_append(sb, "// tpkg.config.td\n")
    sb_append(sb, "// tie:data\n")
    sb_append(sb, "[\n")
    sb_append(sb, "    \"name\": \"" + name + "\",\n")
    sb_append(sb, "    \"version\": \"0.1.0\",\n")
    sb_append(sb, "    \"description\": \"tie " + kind + " 项目\",\n")
    sb_append(sb, "    \"kind\": \"" + kind + "\",\n")
    sb_append(sb, "    \"main\": \"" + main_rel + "\",\n")
    sb_append(sb, "    \"author\": \"\",\n")
    sb_append(sb, "    \"license\": \"TPL-2.3\",\n")
    sb_append(sb, "    \"dependencies\": [\n")
    sb_append(sb, "    ],\n")
    sb_append(sb, "]\n")
    return sb_build(sb)
}

func sc_readme(name: string, kind: string, dirs: table<string>, vnotes: table<string>) -> string {
    var sb = string_builder()
    sb_append(sb, "# " + name + "\n\n")
    sb_append(sb, "tie 项目（kind: " + kind + "）/ tie project.\n\n")
    sb_append(sb, "由 [tpkg](https://github.com/tie-lang/tpkg) 脚手架 `tpkg new --kind=" + kind + "` 生成。\n\n")
    sb_append(sb, "## 结构 / Structure\n\n")
    sb_append(sb, "```\n")
    sb_append(sb, name + "/\n")
    var i: i64 = 0
    while i < len(dirs) {
        sb_append(sb, "  " + dirs[i] + "/\n")
        i = i + 1
    }
    sb_append(sb, "```\n\n")
    if len(vnotes) > 0 {
        sb_append(sb, "## 变体 / Variants\n\n")
        var v: i64 = 0
        while v < len(vnotes) {
            sb_append(sb, "- " + vnotes[v] + "\n")
            v = v + 1
        }
        sb_append(sb, "\n")
    }
    sb_append(sb, "## 约定 / Conventions\n\n")
    sb_append(sb, "- 公共面：`tpkg.config.td`（清单）、`LICENSE`、`.gitignore`、`README.md`。\n")
    sb_append(sb, "- 构建产物进 `target/`；本地材料进 `_local_only/`（不入库）。\n")
    sb_append(sb, "- 规范：tie 生态包与项目规范（tpkg-spec）。\n")
    return sb_build(sb)
}

func sc_gitignore() -> string {
    return "# build artifacts\n" +
           "*.exe\n" +
           "*.ll\n" +
           "*.o\n" +
           "*.obj\n" +
           "*.log\n" +
           "\n" +
           "# install / cache / local materials\n" +
           ".tie/\n" +
           "target/\n" +
           "_local_only/\n" +
           "\n" +
           "# os / editor\n" +
           "Thumbs.db\n" +
           ".DS_Store\n" +
           ".idea/\n" +
           ".vscode/\n"
}

// 入口文件内容：lib 档=门面（class）；其余=可编译的 hello（logic）。
func sc_entry(name: string, kind: string, main_rel: string) -> string {
    if kind == "lib" || kind == "bindings" {
        var ns = ns_safe(name)
        return "type tie<class>\n" +
               "// " + name + " —— 库门面（main 指向；唯一承诺的导入面）\n" +
               "\n" +
               "namespace " + ns + " {\n" +
               "    pub func hello() -> string {\n" +
               "        return \"Hello from " + name + "\"\n" +
               "    }\n" +
               "}\n"
    }
    return "type tie<logic>\n" +
           "// 由 tpkg new --kind=" + kind + " 生成（入口：" + main_rel + "）\n" +
           "\n" +
           "func main() {\n" +
           "    println(\"Hello from " + name + "!\")\n" +
           "}\n"
}

// ============================================================================
// 三·五、领域示例文件（每档 1-3 个代表性示例；内容型：td/md/csv/cir/case/prog/libfn）
// ============================================================================
// 数据格式：每档 "rel|type|blurb;rel2|type|blurb;..."（"|" 三段；";" 分条目）。

