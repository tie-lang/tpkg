// 按单字符分隔符切分（sep 为单字符字符串）。
func sc_split_sep(s: string, sep: string) -> table<string> {
    var out = table_new_string()
    var cur: string = ""
    var i: i64 = 0
    var n: i64 = len(s)
    while i < n {
        var c = str_char(s, i)
        if c == sep {
            if cur != "" {
                table_push(out, cur)
            }
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    if cur != "" {
        table_push(out, cur)
    }
    return out
}

// 单字符首次出现位置（无则 -1）。
func sc_find_char(s: string, c: string) -> i64 {
    var i: i64 = 0
    while i < len(s) {
        if str_char(s, i) == c {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// 文件名 stem（去目录去扩展名；'-' '.' → '_'）。
func sc_stem(rel: string) -> string {
    var cut: i64 = 0 - 1
    var i: i64 = len(rel) - 1
    while i >= 0 {
        var c = str_char(rel, i)
        if c == "/" || c == "\\" {
            cut = i
            i = 0 - 1
        } else {
            i = i - 1
        }
    }
    var s2 = rel
    if cut >= 0 {
        s2 = slice(rel, cut + 1, len(rel))
    }
    var dot: i64 = 0 - 1
    i = 0
    while i < len(s2) {
        if str_char(s2, i) == "." {
            dot = i
        }
        i = i + 1
    }
    if dot >= 0 {
        s2 = slice(s2, 0, dot)
    }
    return ns_safe(s2)
}

// 示例内容生成（六型）。
func sc_gen_content(kind: string, rel: string, ftype: string, blurb: string) -> string {
    if ftype == "td" {
        return "// " + rel + " —— " + blurb + "\n" +
               "// 由 tpkg new --kind=" + kind + " 生成；按需替换为真实内容。\n" +
               "[\n" +
               "    \"example\": \"value\",\n" +
               "    \"note\": \"" + blurb + "\",\n" +
               "]\n"
    }
    if ftype == "md" {
        return "# " + blurb + "\n\n" +
               "（" + kind + " 示例文件，由 tpkg new 生成；按需替换。）\n\n" +
               "- 要点一\n" +
               "- 要点二\n"
    }
    if ftype == "csv" {
        return "id,name,value\n1,sample,42\n2,example,7\n"
    }
    if ftype == "cir" {
        return "* SPICE 仿真示例（" + kind + "，由 tpkg new 生成——替换为真实网表）\n" +
               "V1 in 0 DC 5\n" +
               "R1 in out 1k\n" +
               "C1 out 0 1u\n" +
               ".op\n" +
               ".end\n"
    }
    if ftype == "case" {
        return "# 用例夹具（示例格式，随用例约定演进）\n" +
               "INPUT: hello\n" +
               "EXPECT: hello\n"
    }
    if ftype == "prog" {
        return "type tie<logic>\n" +
               "// " + rel + " —— " + blurb + "\n" +
               "// 由 tpkg new --kind=" + kind + " 生成（示例程序）。\n" +
               "\n" +
               "func main() {\n" +
               "    println(\"" + blurb + "\")\n" +
               "}\n"
    }
    if ftype == "libfn" {
        var ns = sc_stem(rel)
        return "type tie<class>\n" +
               "// " + rel + " —— " + blurb + "\n" +
               "// 由 tpkg new --kind=" + kind + " 生成（模块骨架，按需实现）。\n" +
               "\n" +
               "namespace " + ns + " {\n" +
               "    pub func example() -> string {\n" +
               "        return \"" + blurb + "\"\n" +
               "    }\n" +
               "}\n"
    }
    return ""
}

// 写领域示例文件；返回失败计数。
func sc_extra_write(dir: string, kind: string) -> i64 {
    var spec = sc_extra(kind)
    if spec == "" {
        return 0
    }
    var failed: i64 = 0
    var items = sc_split_sep(spec, ";")
    var i: i64 = 0
    while i < len(items) {
        var e = items[i]
        var p1 = sc_find_char(e, "|")
        if p1 >= 0 {
            var rel = slice(e, 0, p1)
            var rest = slice(e, p1 + 1, len(e))
            var p2 = sc_find_char(rest, "|")
            if p2 >= 0 {
                var ftype = slice(rest, 0, p2)
                var blurb = slice(rest, p2 + 1, len(rest))
                var content = sc_gen_content(kind, rel, ftype, blurb)
                if content != "" {
                    if !sc_write(dir + "/" + rel, content) {
                        failed = failed + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return failed
}

// ============================================================================
// 四、生成（官方档）
// ============================================================================

func mk_parent(path: string) -> bool {
    // 建上级目录（逐级找最后一个分隔符）
    var cut: i64 = 0 - 1
    var i: i64 = len(path) - 1
    while i >= 0 {
        var c = str_char(path, i)
        if c == "/" || c == "\\" {
            cut = i
            i = 0 - 1
        } else {
            i = i - 1
        }
    }
    if cut < 0 {
        return true
    }
    return mkdir_all(slice(path, 0, cut))
}

func sc_write(path: string, content: string) -> bool {
    if g_sc_only_absent {
        if file_exists(path) {
            return true
        }
    }
    if !mk_parent(path) {
        return false
    }
    return file_write(path, content)
}

pub func sc_generate(dir: string, name: string, kind: string) -> i64 {
    return sc_generate_v(dir, name, kind, table_new_string())
}

// 带变体生成（变体合法性/冲突已由调用方校验；本函数只应用）。
pub func sc_generate_v(dir: string, name: string, kind: string, variants: table<string>) -> i64 {
    g_sc_only_absent = false
    return sc_impl(dir, name, kind, variants)
}

// 宽容生成：已存在文件跳过（用于在既有目录补骨架，如 tie init）。
pub func sc_fill_missing(dir: string, name: string, kind: string) -> i64 {
    return sc_fill_missing_v(dir, name, kind, table_new_string())
}

// 宽容 + 变体（变体合法性/冲突已由调用方校验）。
pub func sc_fill_missing_v(dir: string, name: string, kind: string, variants: table<string>) -> i64 {
    g_sc_only_absent = true
    return sc_impl(dir, name, kind, variants)
}

func sc_impl(dir: string, name: string, kind: string, variants: table<string>) -> i64 {
    var def = sc_def(kind)
    if def == "" {
        return 1
    }
    var main_rel = sc_main_rel(kind)
    var dirs = sc_dirs(kind)
    // ---- 变体应用（add/del 目录、note；cli --script = 轻档布局） ----
    var vnotes = table_new_string()
    var light = false
    var vi: i64 = 0
    while vi < len(variants) {
        var v = variants[vi]
        if kind == "cli" {
            if v == "script" {
                light = true
            }
        }
        var adds = sc_vspec_seg(kind, v, 0)
        var dels = sc_vspec_seg(kind, v, 1)
        var note = sc_vspec_seg(kind, v, 2)
        if note != "" {
            table_push(vnotes, "`--" + v + "`：" + note)
        }
        if dels != "" {
            var dl = sc_split_csv(dels)
            var di: i64 = 0
            while di < len(dl) {
                dirs = sc_remove_str(dirs, dl[di])
                di = di + 1
            }
        }
        if adds != "" {
            var al = sc_split_csv(adds)
            var ai2: i64 = 0
            while ai2 < len(al) {
                table_push(dirs, al[ai2])
                ai2 = ai2 + 1
            }
        }
        vi = vi + 1
    }
    // 入口（lib 门面=<name>；轻档=根扁平 main.tie）
    var entry_rel = main_rel
    if kind == "lib" {
        entry_rel = "src/" + name + ".tie"
    }
    if light {
        entry_rel = "main.tie"
    }
    var failed: i64 = 0
    // 公共面
    if !sc_write(dir + "/tpkg.config.td", sc_config(name, kind, entry_rel)) {
        failed = failed + 1
    }
    if !sc_write(dir + "/README.md", sc_readme(name, kind, dirs, vnotes)) {
        failed = failed + 1
    }
    if !sc_write(dir + "/LICENSE", lic.lic_text(g_sc_license_id)) {
        failed = failed + 1
    }
    if !sc_write(dir + "/.gitignore", sc_gitignore()) {
        failed = failed + 1
    }
    // 档面：目录 + .gitkeep（轻档=无目录，根扁平）
    var i: i64 = 0
    if light == false {
        while i < len(dirs) {
            var d = dir + "/" + dirs[i]
            if !mkdir_all(d) {
                failed = failed + 1
            }
            if !sc_write(d + "/.gitkeep", "") {
                failed = failed + 1
            }
            i = i + 1
        }
    }
    if !sc_write(dir + "/" + entry_rel, sc_entry(name, kind, entry_rel)) {
        failed = failed + 1
    }
    // 领域示例文件（轻档跳过）
    if light == false {
        failed = failed + sc_extra_write(dir, kind)
    }
    return failed
}

// ============================================================================
// 五、变体（档内场景开关；ch04 §4.2 / ch05 各档变体行）
// ============================================================================
// 编码 "add_dirs|del_dirs|note"（add/del 逗号分隔，可空）。
// cli 的 --script = 布局级变体（轻档，根扁平单文件）——由生成器特判。

func sc_variant_def(kind: string, v: string) -> string {
    if kind == "website" {
        if v == "static" { return "||纯静态生成（静态资产流）" }
        if v == "ssr" { return "||动态渲染（服务端）" }
        if v == "api" { return "src/api||附带后端面" }
    }
    if kind == "backend" {
        if v == "serverless" { return "src/functions||函数路由/触发器（无服务器）" }
        if v == "realtime" { return "src/realtime||实时服务（长连接/状态同步）" }
        if v == "with-db" { return "migrations||数据库迁移面" }
        if v == "micro" { return "services||多服务拆分" }
    }
    if kind == "app" {
        if v == "game" { return "src/game||游戏（主循环/场景/实体/资源管线）" }
    }
    if kind == "cli" {
        if v == "script" { return "||轻档脚本形态（根扁平单文件）" }
        if v == "with-lib" { return "lib||与 CLI 双目标" }
    }
    if kind == "lib" {
        if v == "agg" { return "sub||聚合库（一个包聚合多个子库）" }
        if v == "sdk" { return "bindings,docs||SDK 面（bindings/examples/docs）" }
    }
    if kind == "plugin" {
        if v == "browser" { return "||宿主=browser" }
    }
    if kind == "os" {
        if v == "driver" { return "ext||树外驱动/模块" }
    }
    if kind == "embedded" {
        if v == "robotics" { return "src/perception,src/decision,sim||机器人（感知/决策 + sim 仿真面）" }
    }
    if kind == "data" {
        if v == "analysis" { return "reports||报告渲染面" }
    }
    if kind == "hardware" {
        if v == "mech" { return "||机械方向" }
        if v == "rtl" { return "rtl||芯片方向（RTL）" }
    }
    if kind == "art" {
        if v == "font" { return "fonts||字体工程" }
        if v == "design" { return "design||设计系统" }
    }
    return ""
}

pub func sc_variant_valid(kind: string, v: string) -> bool {
    return sc_variant_def(kind, v) != ""
}

pub func sc_variant_list(kind: string) -> table<string> {
    var t = table_new_string()
    if kind == "website" {
        table_push(t, "static")
        table_push(t, "ssr")
        table_push(t, "api")
    }
    if kind == "backend" {
        table_push(t, "serverless")
        table_push(t, "realtime")
        table_push(t, "with-db")
        table_push(t, "micro")
    }
    if kind == "app" {
        table_push(t, "game")
    }
    if kind == "cli" {
        table_push(t, "script")
        table_push(t, "with-lib")
    }
    if kind == "lib" {
        table_push(t, "agg")
        table_push(t, "sdk")
    }
    if kind == "plugin" {
        table_push(t, "browser")
    }
    if kind == "os" {
        table_push(t, "driver")
    }
    if kind == "embedded" {
        table_push(t, "robotics")
    }
    if kind == "data" {
        table_push(t, "analysis")
    }
    if kind == "hardware" {
        table_push(t, "mech")
        table_push(t, "rtl")
    }
    if kind == "art" {
        table_push(t, "font")
        table_push(t, "design")
    }
    return t
}

// 变体冲突（ch04：冲突变体由 tpkg 生成时拒绝）。
pub func sc_conflict(kind: string, v1: string, v2: string) -> bool {
    if kind == "website" {
        if v1 == "static" && v2 == "ssr" { return true }
        if v1 == "ssr" && v2 == "static" { return true }
    }
    if kind == "backend" {
        if v1 == "serverless" && v2 == "realtime" { return true }
        if v1 == "realtime" && v2 == "serverless" { return true }
    }
    return false
}

// 取变体 spec 的段（0=add / 1=del / 2=note）。
func sc_vspec_seg(kind: string, v: string, i: i64) -> string {
    var spec = sc_variant_def(kind, v)
    if spec == "" {
        return ""
    }
    var cur: i64 = 0
    var s: string = ""
    var n: i64 = len(spec)
    var k: i64 = 0
    while k <= n {
        var at_end = (k == n)
        var is_sep = false
        if !at_end {
            var c = str_char(spec, k)
            if c == "|" { is_sep = true }
        }
        if at_end || is_sep {
            if cur == i {
                return s
            }
            cur = cur + 1
            s = ""
        } else {
            s = s + str_char(spec, k)
        }
        k = k + 1
    }
    return ""
}

// ============================================================================
// 六、用户模板
// ============================================================================

pub func sc_user_root() -> string {
    var h = get_env("USERPROFILE")
    if h == "" {
        h = get_env("HOME")
    }
    if h == "" {
        return ""
    }
    return h + "/.tpkg/templates"
}

pub func sc_user_list() -> table<string> {
    var out = table_new_string()
    var root = sc_user_root()
    if root == "" {
        return out
    }
    var entries = list_dir(root)
    var i: i64 = 0
    while i < len(entries) {
        if entries[i] != "." && entries[i] != ".." {
            table_push(out, entries[i])
        }
        i = i + 1
    }
    return out
}

pub func sc_user_exists(tpl: string) -> bool {
    var root = sc_user_root()
    if root == "" {
        return false
    }
    var items = list_dir(root + "/" + tpl)
    return len(items) > 0
}

// 目录条目判定（walk_dir 会含目录条目；被他人以 "<它>/" 前缀命中即目录）。
func is_dir_entry(all: table<string>, rel: string) -> bool {
    var pfx = rel + "/"
    var i: i64 = 0
    while i < len(all) {
        if i < len(all) {
            var other = all[i]
            if other != rel {
                if starts_with(other, pfx) {
                    return true
                }
            }
        }
        i = i + 1
    }
    return false
}

pub func sc_generate_user(dir: string, name: string, tpl: string) -> i64 {
    var root = sc_user_root()
    if root == "" {
        return 1
    }
    var src_root = root + "/" + tpl
    var files = walk_dir(src_root)
    if len(files) == 0 {
        return 1
    }
    // 规范化（walk_dir 返回以 src_root 为前缀的完整路径——先剥前缀，再统一分隔符）
    var pre1 = src_root + "/"
    var pre2 = src_root + "\\"
    var all = table_new_string()
    var i: i64 = 0
    while i < len(files) {
        var rel = files[i]
        if starts_with(rel, pre1) {
            rel = slice(rel, len(pre1), len(rel))
        } else if starts_with(rel, pre2) {
            rel = slice(rel, len(pre2), len(rel))
        }
        if starts_with(rel, "./") {
            rel = slice(rel, 2, len(rel))
        }
        if starts_with(rel, ".\\") {
            rel = slice(rel, 2, len(rel))
        }
        // '\' → '/'
        var sb = string_builder()
        var k: i64 = 0
        while k < len(rel) {
            var b = str_byte(rel, k) & 0xFF
            if b == 92 {
                sb_append_byte(sb, 47)
            } else {
                sb_append_byte(sb, b)
            }
            k = k + 1
        }
        // 注意：all 表保存**模板原名**（读源与目录判定）；写入目标名在复制循环中替换
        table_push(all, sb_build(sb))
        i = i + 1
    }
    var failed: i64 = 0
    i = 0
    while i < len(all) {
        var rel = all[i]
        if !is_dir_entry(all, rel) {
            // 文件：读 + {{name}} 替换 + 写
            var content = file_read(src_root + "/" + rel)
            content = replace_all(content, "{{name}}", name)
            // 文件名亦可含 {{name}}（如插件模板 src/{{name}}_plugin.tie）
            var dst_rel = replace_all(rel, "{{name}}", name)
            if !sc_write(dir + "/" + dst_rel, content) {
                failed = failed + 1
            }
        } else {
            // 目录：建 + .gitkeep（保证结构入库）
            var dst_dir = replace_all(rel, "{{name}}", name)
            if !mkdir_all(dir + "/" + dst_dir) {
                failed = failed + 1
            }
            if !sc_write(dir + "/" + dst_dir + "/.gitkeep", "") {
                failed = failed + 1
            }
        }
        i = i + 1
    }
    return failed
}

}
