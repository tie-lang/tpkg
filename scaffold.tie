    if kind == "website" { return "src/pages.td|td|页面与路由表（示例）;content/home.md|md|首页内容（示例）" }
    if kind == "backend" { return "src/routes/hello.tie|libfn|路由处理函数（示例）;config/dev.td|td|开发环境配置（示例）" }
    if kind == "app" { return "src/ui/home.tie|libfn|视图/组件（示例）" }
    if kind == "cli" { return "src/commands/hello.tie|libfn|子命令实现（示例）;tests/smoke.tie|prog|冒烟测试（示例）" }
    if kind == "lib" { return "examples/quickstart.tie|prog|快速上手示例;tests/basic.tie|prog|基础测试（示例）" }
    if kind == "bindings" { return "tests/kat.md|md|跨语言对拍（KAT）说明" }
    if kind == "plugin" { return "src/register.tie|libfn|插件注册入口（示例）" }
    if kind == "language" { return "tests/cases/example.case|case|用例夹具（正例格式示例）" }
    if kind == "conformance" { return "cases/example.case|case|用例（正例格式示例）" }
    if kind == "ops" { return "cfg/dev.td|td|环境与部署配置（示例）" }
    if kind == "os" { return "mk/rules.td|td|构建规则（示例）" }
    if kind == "embedded" { return "arch/board.td|td|板级参数（示例）;drivers/gpio.tie|libfn|驱动骨架（示例）" }
    if kind == "spec" { return "source/outline.md|md|规范目录（示例）" }
    if kind == "doc" { return "data/example.td|td|图表数据（示例）" }
    if kind == "book" { return "src/chapters/ch01.md|md|第一章（示例）" }
    if kind == "paper" { return "src/sections/abstract.md|md|摘要（示例）" }
    if kind == "slides" { return "src/deck.td|td|页表（示例）" }
    if kind == "course" { return "slides/lesson01.md|md|课件（示例）;exercises/set01.md|md|练习（示例）" }
    if kind == "data" { return "schema/example.td|td|结构声明（示例）;data/sample.csv|csv|数据样例" }
