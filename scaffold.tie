    if kind == "simulation" { return "params/default.td|td|场景参数（示例）" }
    if kind == "experiment" { return "protocol/plan.md|md|实验方案（模板）" }
    if kind == "hardware" { return "src/params.td|td|设计参数（示例）;sim/testbench.md|md|测试台说明（示例）" }
    if kind == "circuit" { return "sim/example.cir|cir|SPICE 仿真（示例）" }
