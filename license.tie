// ============================================================================
// 五、校验（check：清单声明 vs LICENSE 实况）
// ============================================================================

// 读 LICENSE 文件并对照声明；打印结论。返回 0=一致 1=不一致 2=未识别/缺文件。
pub func lic_check_report(declared: string, lic_path: string) -> i64 {
    if !file_exists(lic_path) {
        print_err("[pkg] 许可证校验: 缺少 LICENSE 文件（" + lic_path + "）\n")
        return 2
    }
    var src = file_read(lic_path)
    var d = lic_detect(src)
    var detected = d.0
    if detected == "Custom" {
        print_err("[pkg] 许可证校验: LICENSE 无法识别为内置大全中的许可证（视为自定义条款）\n")
        return 2
    }
    if declared == "" {
        println("[pkg] 许可证校验: LICENSE 识别为 " + detected + "（清单未声明 license）")
        return 0
    }
    if declared == detected {
        println("[pkg] 许可证校验: 清单声明与 LICENSE 实况一致（" + detected + "）")
        return 0
    }
    print_err("[pkg] 提示: 清单声明 license=" + declared + " 与 LICENSE 实况 " + detected +
              " 不一致（以 LICENSE 文件为准）\n")
    return 1
}

}
