type tie<class>
// pack.tie —— S3.2：打包模块（多文件包 L1c + tieir 分发 + 签名 P5c / p.9.2.2 转正）
//
// 职责：`tie pack` 把当前项目打包为**分发单元**（源码 + tie.pkg + .tieir +
// signature），供 path/git/registry 三种源安装消费：
//   1. 读 tie.pkg（name/version/main/exports 由 main 传入，本模块不重复解析）；
//   2. 校验清单字段（name/version/main 必备；exports 可选 = 附加导出入口）；
//   3. 编译入口文件为 .tieir（调用 tiec --tieir-out，S3.2 新增编译器选项），
//      多文件包（L1c）：包内模块互相 import 私有，对外只暴露入口声明面；
//   4. 计算 .tieir 的 **TSHA1-f** 指纹（n=48，标准库 std/tsha1.tie，与
//      keel_auditor.fingerprint_tree / keelpkg `.zd.fp` 同一指纹模型）+
//      生成 signature 文件（P5c：fp + 签名者信息；私钥签名/公钥验证的完整
//      RSA/ED25519 超出 tie 纯文本能力，第一版 = 内容指纹 + 签名者信息，
//      安装时重算指纹比对防篡改——指纹即完整性底线，p.9.2.2 由 FNV-1a 升级为
//      TSHA1-f）；
//   5. 打 tar.gz 到 .tie/dist/<name>-<version>.tar.gz（首层为项目文件）。
//
// `tie verify <目录>`：校验已安装包（signature 存在 + .tieir TSHA1-f 指纹匹配）。
//
// tie 约束处理（重要）：
// - 本模块 import std/bytes.tie（读字节）与 std/tsha1.tie（TSHA1-f 指纹）；
//   不 import 其它 pkg 模块（main 分派）；
// - 表参数元素类型静态未知：跨模块只传字符串/标量；bytes.read 返回 table<i64>
//   在函数内处理（本文件顶层路径全局函数不可收表参，故指纹读取在命名空间内）；
// - && 非短路：边界判断与下标分开；
// - 无 continue/break/递归：迭代 + return 提前退出。

import "./std/bytes.tie"
import "./std/tsha1.tie"

namespace pack {
    // ================= 通用字符串工具（自备） =================

    func slice(s: string, start: i64, end: i64) -> string {
        var n: i64 = len(s)
        var lo: i64 = start
        if lo < 0 {
            lo = 0
        }
        if lo > n {
            lo = n
        }
        var hi: i64 = end
        if hi < 0 {
            hi = 0
        }
        if hi > n {
            hi = n
        }
        var result: string = ""
        var i: i64 = lo
        while i < hi {
            result = result + str_char(s, i)
            i = i + 1
        }
        return result
    }

    func find(s: string, sub: string) -> i64 {
        var n: i64 = len(s)
        var m: i64 = len(sub)
        if m == 0 {
            return 0
        }
        if m > n {
            return -1
        }
        var i: i64 = 0
        while i <= n - m {
            var j: i64 = 0
            var matched: bool = true
            while j < m && matched {
                if str_char(s, i + j) != str_char(sub, j) {
                    matched = false
                }
                j = j + 1
            }
            if matched {
                return i
            }
            i = i + 1
        }
        return -1
    }

    func starts_with(s: string, prefix: string) -> bool {
        var n: i64 = len(s)
        var m: i64 = len(prefix)
        if m > n {
            return false
        }
        var i: i64 = 0
        while i < m {
            if str_char(s, i) != str_char(prefix, i) {
                return false
            }
            i = i + 1
        }
        return true
    }

    func ends_with(s: string, suffix: string) -> bool {
        var n: i64 = len(s)
        var m: i64 = len(suffix)
        if m > n {
            return false
        }
        var i: i64 = 0
        while i < m {
            if str_char(s, n - m + i) != str_char(suffix, i) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // 是否合法的 x.y.z 版本串（纯数字与点、首尾数字、无连续点）。
    func is_semver(s: string) -> bool {
        var n: i64 = len(s)
        if n == 0 {
            return false
        }
        var digits = "0123456789"
        if find(digits, str_char(s, 0)) < 0 {
            return false
        }
        if find(digits, str_char(s, n - 1)) < 0 {
            return false
        }
        var prev_dot: bool = false
        var i: i64 = 0
        while i < n {
            var c = str_char(s, i)
            if c == "." {
                if prev_dot {
                    return false
                }
                prev_dot = true
            } else if find(digits, c) >= 0 {
                prev_dot = false
            } else {
                return false
            }
            i = i + 1
        }
        return true
    }

    // ================= TSHA1-f 指纹（P5c 载体，与 keel_auditor / keelpkg 同模型） =================

    // 字节表（bytes.read 返回的 table<i64>，元素 0..255）→ 二进制安全字符串
    // （tsha1f 的输入；与 keel_auditor.bytes_to_str / keelpkg 同款）。
    func fp_bytes(t: table<i64>) -> string {
        var sb = string_builder()
        var i: i64 = 0
        while i < len(t) {
            sb_append_byte(sb, t[i])
            i = i + 1
        }
        return sb_build(sb)
    }

    // 单文件 TSHA1-f 指纹（n=48，48 进制）。读文件字节 → tsha1f；失败/空返回空串。
    pub func file_fp(path: string) -> string {
        if !file_exists(path) {
            return ""
        }
        var t = bytes.read(path)
        if len(t) == 0 {
            return ""
        }
        return tsha.tsha1f(fp_bytes(t), 48)
    }

    // ================= signature（P5c） =================

    // 生成 signature 文本：包名/版本/内容指纹/签名者（TIE_SIGNER 环境变量，
    // 缺省 anonymous）。签名者信息为明文——第一版以 TSHA1-f 指纹为完整性底线，
    // 公钥验签（注册表持公钥）标注后续（见 docs/PACKAGE.md 未决）。
    pub func signature_text(name: string, version: string, fp: string) -> string {
        var signer = get_env("TIE_SIGNER")
        if signer == "" {
            signer = "anonymous"
        }
        return "[tie-signature]\n" +
               "package: " + name + "\n" +
               "version: " + version + "\n" +
               "fp: " + fp + "\n" +
               "signer: " + signer + "\n"
    }

    // 解析 signature 文本的 fp 字段（TSHA1-f 指纹串，读至行尾）；未找到返回空串。
    pub func signature_fp(sig: string) -> string {
        var marker = "fp: "
        var q = find(sig, marker)
        if q < 0 {
            return ""
        }
        var start = q + len(marker)
        var n = len(sig)
        var sb = string_builder()
        var i: i64 = start
        while i < n {
            var c = str_char(sig, i)
            if c == "\n" || c == "\r" {
                i = n
            } else {
                sb_append_byte(sb, char_code(c))
                i = i + 1
            }
        }
        return sb_build(sb)
    }

    // 解析 signature 文本的 package 字段；未找到返回空串。
    pub func signature_pkg(sig: string) -> string {
        var marker = "package: "
        var q = find(sig, marker)
        if q < 0 {
            return ""
        }
        var nl = find(slice(sig, q, len(sig)), "\n")
        if nl < 0 {
            return slice(sig, q + len(marker), len(sig))
        }
        return slice(sig, q + len(marker), q + nl)
    }

    // ================= tie pack 主流程 =================

    // 打包：编译 tieir + 签名 + tar.gz。name/version/main 由 main 从 tie.pkg
    // 读出传入；exports 为附加导出入口（逗号分隔，可为空串）。
    pub func pack(name: string, version: string, main_file: string, exports: string) -> i64 {
        // 1) 校验清单字段
        if name == "" {
            print_err("[pkg] tie.pkg 缺少 name 字段\n")
            return 1
        }
        if version == "" {
            print_err("[pkg] tie.pkg 缺少 version 字段\n")
            return 1
        }
        if main_file == "" {
            print_err("[pkg] tie.pkg 缺少 main 字段\n")
            return 1
        }
        if !is_semver(version) {
            print_err("[pkg] 版本必须是 x.y.z 形式（当前: " + version + "）\n")
            return 1
        }
        if !file_exists(main_file) {
            print_err("[pkg] 入口文件不存在: " + main_file + "\n")
            return 1
        }
        // 2) 校验附加导出入口（L1c 多文件包：exports 字段 = 对外导出面声明）
        var ex_ok: bool = true
        var ex_seq = exports
        while ex_seq != "" {
            var comma = find(ex_seq, ",")
            var one = ex_seq
            if comma >= 0 {
                one = slice(ex_seq, 0, comma)
                ex_seq = slice(ex_seq, comma + 1, len(ex_seq))
            } else {
                ex_seq = ""
            }
            if one != "" {
                if !file_exists(one) {
                    print_err("[pkg] exports 入口不存在: " + one + "\n")
                    ex_ok = false
                }
            }
        }
        if !ex_ok {
            return 1
        }
        // 3) 编译入口 → .tieir（分发单元；tiec --tieir-out 见 driver.tie S3.2）。
        //    注：必须 --no-cache——tiec 产物缓存命中时跳过编译、不产出 .tieir，
        //    会导致包无法打包（p.9.2.2 发布确定性）。
        var tieir_name = name + "-" + version + ".tieir"
        var rc = exec_code("tiec " + main_file + " --tieir-out " + tieir_name + " --no-cache")
        if rc != 0 {
            print_err("[pkg] tieir 编译失败（可手动执行: tiec " + main_file + " --tieir-out " + tieir_name + "）\n")
            return 1
        }
        if !file_exists(tieir_name) {
            print_err("[pkg] tieir 产物缺失: " + tieir_name + "\n")
            return 1
        }
        // 4) 计算内容指纹 + 生成 signature（P5c：TSHA1-f）
        var fp = file_fp(tieir_name)
        if fp == "" {
            print_err("[pkg] 计算 tieir 指纹失败\n")
            return 1
        }
        var sig = signature_text(name, version, fp)
        if !file_write("signature", sig) {
            print_err("[pkg] 写入 signature 失败\n")
            return 1
        }
        println("[pkg] 已生成 " + tieir_name + "（TSHA1-f 指纹 " + fp + "）")
        println("[pkg] 已生成 signature（签名者: " + get_env("TIE_SIGNER") + "）")
        // 5) 重建 staging 目录（无条件清旧）
        var staging = ".tie/dist-stage"
        remove_dir_all(staging)
        if !mkdir_all(staging) {
            print_err("[pkg] 创建 staging 失败: " + staging + "\n")
            return 1
        }
        // 6) 收集项目文件并复制（排除 .tie/.git/target/pkg/dist 与产物）
        var files = walk_dir(".")
        var fi: i64 = 0
        var copied: i64 = 0
        while fi < len(files) {
            var rel = strip_dotrel(files[fi])
            if keep_for_pack(rel) {
                var dest = path_join(staging, rel)
                var parent = path_dirname(dest)
                if parent == "" {
                    parent = staging
                }
                if !mkdir_all(parent) {
                    print_err("[pkg] 创建目录失败: " + parent + "\n")
                    return 1
                }
                if !file_copy(rel, dest) {
                    print_err("[pkg] 复制失败: " + rel + "\n")
                    return 1
                }
                copied = copied + 1
            }
            fi = fi + 1
        }
        println("[pkg] 收集文件 " + to_string(copied) + " 个")
        // 7) 打 tar.gz（首层为项目文件；安装解压后直落 .tie/deps/<name>/）
        if !mkdir_all(".tie/dist") {
            print_err("[pkg] 创建 .tie/dist 失败\n")
            return 1
        }
        var out = ".tie/dist/" + name + "-" + version + ".tar.gz"
        if file_exists(out) {
            file_delete(out)
        }
        var trc = exec_code("tar -czf " + out + " -C " + staging + " .")
        remove_dir_all(staging)
        if trc != 0 {
            print_err("[pkg] tar 打包失败（退出码 " + to_string(trc) + "，请确认系统 tar 可用）\n")
            return 1
        }
        println("[pkg] 已打包: " + out)
        println("[pkg] 分发单元 = tieir + 源码 + signature（P5c 安装时校验哈希）")
        return 0
    }

    // 规范化 walk_dir 的 Windows `.\` / Unix `./` 前缀（去除），便于前缀判定与路径拼接。
    func strip_dotrel(rel: string) -> string {
        if starts_with(rel, "./") {
            return slice(rel, 2, len(rel))
        }
        if starts_with(rel, ".\\") {
            return slice(rel, 2, len(rel))
        }
        return rel
    }

    // 文件是否纳入发布包（与 publish.keep_for_publish 同规则，排除产物目录）。
    func keep_for_pack(rel: string) -> bool {
        if starts_with(rel, ".tie") {
            return false
        }
        if starts_with(rel, ".git") {
            return false
        }
        if starts_with(rel, "target") {
            return false
        }
        if starts_with(rel, "pkg") {
            return false
        }
        if starts_with(rel, "dist") {
            return false
        }
        if ends_with(rel, ".exe") {
            return false
        }
        if ends_with(rel, ".tar.gz") {
            return false
        }
        return true
    }

    // ================= tie verify 主流程（P5c 安装校验） =================

    // 校验已安装包目录：signature 存在 + .tieir TSHA1-f 指纹匹配 + 包名一致。
    // dir 为包目录（如 .tie/deps/my_pkg）；name 为期望包名。
    // 返回 0 通过 / 1 失败（已打印原因）。
    pub func verify(dir: string, name: string) -> i64 {
        var sig_path = path_join(dir, "signature")
        if !file_exists(sig_path) {
            print_err("[pkg] 校验失败: 缺少 signature（包未签名或已损坏）\n")
            return 1
        }
        var sig = file_read(sig_path)
        // 包名一致性（防错装/目录混淆）
        var sp = signature_pkg(sig)
        if sp != name {
            print_err("[pkg] 校验失败: signature 包名 '" + sp + "' ≠ 期望 '" + name + "'\n")
            return 1
        }
        // 找 .tieir（目录内唯一：name-version.tieir；扫描首层）。
        // 注：walk_dir(dir) 返回以 dir 为前缀的完整相对路径（非 dir 相对子路径），
        //     故直接用作读取路径，勿再 path_join(dir, …)。
        var tieir_file = ""
        var files = walk_dir(dir)
        var fi2: i64 = 0
        while fi2 < len(files) {
            var rel = files[fi2]
            if ends_with(rel, ".tieir") {
                tieir_file = rel
            }
            fi2 = fi2 + 1
        }
        if tieir_file == "" {
            print_err("[pkg] 校验失败: 包内无 .tieir 分发单元\n")
            return 1
        }
        // TSHA1-f 指纹比对（完整性底线；防篡改/防损坏；TSHA1-f 与 keel_auditor 同款）。
        // tieir_file 已是完整相对路径，直接读取。
        var fp = file_fp(tieir_file)
        if fp == "" {
            print_err("[pkg] 校验失败: 读取 tieir 失败\n")
            return 1
        }
        var sfp = signature_fp(sig)
        if sfp == "" {
            print_err("[pkg] 校验失败: signature fp 字段非法\n")
            return 1
        }
        if fp != sfp {
            print_err("[pkg] 校验失败: 指纹不匹配（" + fp + " ≠ signature " + sfp + "）——包已被篡改\n")
            return 1
        }
        println("[pkg] 校验通过: " + name + "（" + tieir_file + " TSHA1-f 指纹 " + fp + " 匹配）")
        return 0
    }
}
